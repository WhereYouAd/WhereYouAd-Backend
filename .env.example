# 1. Database Configuration
DB_URL=jdbc:mysql://localhost:3306/whereyouad?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# 2. Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Mail Configuration (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_google_app_password_here

# 4. OAuth2 Social Login Configuration
# Naver
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Kakao
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# 5. JWT Configuration
JWT_SECRET=your_very_long_and_secret_random_string_for_signing_tokens_at_least_64_characters

# 6. Frontend Redirect URL
OAUTH2_REDIRECT_URL=http://localhost:3000/oauth2/redirect

# 7. SMS
SMS_API_KEY=your_sms_api_key
SMS_SECRET_KEY=your_sms_secret_key
SMS_SENDER_NUMBER=01012345678

# 8. Server Configuration
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

#9 OpenAI
OPENAI_API_KEY=your_openai_api_key

#10 AES
AES_SECRET=your_aes_secret_key

# 11. Meta Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8080/api/meta/callback
META_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth2/meta/result

# AWS
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key

# Kafka
KAFKA_HOST_IP=localhost
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Google Ads
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_OAUTH2_REDIRECT_URL=your_google_ads_oauth2_redirect_url
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth2/google/result

# Google Ads Test Account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_google_ads_login_customer_id

# Web Push (VAPID)
# 최초 1회 아래 방법으로 발급 후 값 고정:
#   npx web-push generate-vapid-keys
# (or) Node REPL/자바 스니펫으로 65바이트 P-256 공개키 / 32바이트 개인키 Base64URL 인코딩
VAPID_PUBLIC_KEY=your_vapid_public_key_base64url
VAPID_PRIVATE_KEY=your_vapid_private_key_base64url
VAPID_SUBJECT=mailto:whereyouadofficial@gmail.com

#쿠키 설정 - 로컬에선 비워두면 기본값(false,빈값,Lax)
#운영 배포는 배포 환경에 맞게 깃허브 secrets 로 관리중(노션 참조)
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Lax
